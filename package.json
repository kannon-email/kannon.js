{
  "name": "kannon.js",
  "version": "1.1.0",
  "description": "Official Node.js client library for Kannon, the cloud-native email sender",
  "keywords": [
    "email",
    "node",
    "kannon",
    "rest"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kannon-email/kannon.js"
  },
  "license": "ISC",
  "author": "ludusrusso",
  "type": "module",
  "main": "lib/mod.js",
  "types": "lib/mod.d.ts",
  "files": [
    "lib/**/*"
  ],
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.build.json",
    "lint": "biome check .",
    "prepare": "husky",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:email": "tsx scripts/send-test-email.ts",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "husky": "^9.1.7",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "ultracite": "8.2.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  }
}
