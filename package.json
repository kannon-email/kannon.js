{
  "name": "kannon.js",
  "version": "1.0.2",
  "description": "Kannon node client libreary",
  "keywords": [
    "email",
    "node",
    "grpc"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kannon-email/kannon.js"
  },
  "license": "ISC",
  "author": "ludusrusso",
  "type": "module",
  "main": "lib/mod.js",
  "types": "lib/mod.d.ts",
  "files": [
    "lib/**/*"
  ],
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.build.json",
    "lint": "biome check .",
    "prepare": "husky",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:email": "tsx scripts/send-test-email.ts",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.13.0",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-node": "^2.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@bufbuild/buf": "^1.72.0",
    "@bufbuild/protoc-gen-es": "^2.13.0",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "husky": "^9.1.7",
    "tsx": "^4.23.4",
    "typescript": "7.0.2",
    "ultracite": "7.10.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.28.2"
}
