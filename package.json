{
  "name": "kannon.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/kannon-email/kannon.js"
  },
  "version": "1.0.1",
  "description": "Kannon node client libreary",
  "main": "lib/mod.js",
  "types": "lib/mod.d.ts",
  "scripts": {
    "build": "rm -rf lib && tsc",
    "typecheck": "tsc --noEmit --strict",
    "lint": "biome check .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:email": "tsx scripts/send-test-email.ts",
    "prepare": "husky"
  },
  "author": "ludusrusso",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "2.3.12",
    "@bufbuild/buf": "^1.64.0",
    "@bufbuild/protoc-gen-es": "^2.11.0",
    "@types/node": "^25.0.10",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "husky": "^9.1.7",
    "tsx": "^4.21.0",
    "ultracite": "7.0.12",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "@connectrpc/connect": "^2.1.1",
    "@connectrpc/connect-node": "^2.1.1"
  },
  "keywords": [
    "email",
    "node",
    "grpc"
  ],
  "packageManager": "pnpm@10.28.1",
  "files": [
    "lib/**/*"
  ]
}
